# ── BigBro configuration ─────────────────────────────────────────────
# Copy this file to .env and fill in what you use. .env is private — never commit it.

# Which LLM powers BigBro: free | openrouter | openai | anthropic | gemini | ollama | mock
#
# ★ DEFAULT POLICY — 'free': BigBro always uses the NEWEST FREE model that supports
#   tool calling. It checks OpenRouter's public model list once a day (24h cache)
#   and auto-picks the latest one. No paid account needed — just a free key.
BIGBRO_PROVIDER=free

# OpenRouter — free account, NO credit card required: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: pin a specific model instead of auto-free (e.g. a free model you prefer)
# BIGBRO_MODEL=inclusionai/ling-3.0-flash-vl:free

# Where your projects live (BigBro can only touch files inside this folder)
BIGBRO_WORKSPACE=./workspace

# Personal access token for the web dashboard.
# If left empty, BigBro auto-generates one (printed on startup, saved to .env).
# BIGBRO_TOKEN=change-me-to-something-long-and-random

# Web dashboard binding (keep 127.0.0.1 unless you intentionally expose it)
# BIGBRO_HOST=127.0.0.1
# BIGBRO_PORT=8321

# Agent behaviour
# BIGBRO_MAX_TURNS=40
# BIGBRO_TEMPERATURE=0.2

# ── Other provider keys (only if you switch BIGBRO_PROVIDER) ─────────
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1   # for OpenRouter, Groq, LM Studio, vLLM...
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.1:8b

# ── Persona tweaks (optional) ────────────────────────────────────────
# Standing instructions appended to BigBro's persona, e.g.:
# BIGBRO_EXTRA_PERSONA=Always use TypeScript strict mode. Prefer named exports. Reply in concise bullet points.
